# Copy to .env.local. Never commit passwords or server secrets.
# Keep mock mode until migrations, seed and connection checks pass.
ASCENT_DATA_MODE=mock
VITE_DATA_MODE=mock
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
# Persistent Express server: Supabase Session pooler, port 5432.
DATABASE_URL=
# Optional direct/session connection for migrations.
DIRECT_URL=
SUPABASE_PRODUCT_BUCKET=product-images
APP_URL=http://localhost:5173
# Explicit owner bootstrap; no production default password.
ASCENT_OWNER_EMAIL=
ASCENT_OWNER_PASSWORD=
ASCENT_OWNER_NAME=
ASCENT_STAFF_EMAIL=
ASCENT_STAFF_PASSWORD=
ASCENT_STAFF_NAME=
ENABLE_PAYMENT_DEMOS=true

