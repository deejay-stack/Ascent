# Copy to backend/.env.local. Keep server credentials out of frontend configuration.
ASCENT_DATA_MODE=supabase
SUPABASE_URL=
SUPABASE_SECRET_KEY=
# Legacy server keys remain supported as an alternative to SUPABASE_SECRET_KEY.
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_PUBLISHABLE_KEY=
# Runtime: Supabase transaction pooler, port 6543, with ?pgbouncer=true.
DATABASE_URL=
# Direct/session connection for migration advisory locks, port 5432.
DIRECT_URL=
# Optional replacement for the bundled public Supabase CA certificate.
DATABASE_CA_CERT=
SUPABASE_PRODUCT_BUCKET=product-images
APP_URL=http://localhost:5173
# Vercel: APP_URL=https://your-frontend.vercel.app (exact origin, no path).
# Multiple explicitly allowed frontend origins may be separated by commas.
# Vercel sets NODE_ENV=production automatically; do not set PORT there.
# One-time local bootstrap only; these are NOT needed by the deployed runtime.
# Existing users keep their current Auth password even if these values change.
ASCENT_OWNER_EMAIL=
ASCENT_OWNER_PASSWORD=
ASCENT_OWNER_NAME=
ASCENT_STAFF_EMAIL=
ASCENT_STAFF_PASSWORD=
ASCENT_STAFF_NAME=
ENABLE_PAYMENT_DEMOS=false
# Future live checkout adapter templates. These do not activate live payments yet.
PAYMONGO_SECRET_KEY=
PAYMONGO_WEBHOOK_SECRET=
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_WEBHOOK_ID=
PAYPAL_ENV=sandbox
PAYMENT_PUBLIC_URL=
