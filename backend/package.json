{
  "name": "@ascent/backend",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "dev": "node --watch src/index.ts",
    "start": "node dist/index.js",
    "build": "prisma generate && tsc -p tsconfig.json",
    "check:auth": "node scripts/check-auth.mts",
    "owner:restore": "node scripts/restore-owner.mts",
    "pretest:unit": "npm run build",
    "test:unit": "node --test tests/*.test.mts",
    "test:integration": "node --test --test-concurrency=1 tests/integration/*.test.mts",
    "db:validate": "prisma validate",
    "db:generate": "prisma generate",
    "db:migrate": "node scripts/migrate.mts",
    "db:migrate:prisma": "prisma migrate deploy",
    "db:seed": "tsx scripts/seed-supabase.mts",
    "db:check": "node scripts/check-supabase.mts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "typecheck:tools": "tsc -p ../tsconfig.tools.json"
  },
  "dependencies": {
    "@prisma/adapter-pg": "^7.10.0",
    "@prisma/client": "^7.10.1",
    "@supabase/supabase-js": "^2.116.0",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "express-rate-limit": "^8.7.0",
    "helmet": "^8.3.0",
    "multer": "^2.3.0",
    "pg": "^8.23.0",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/multer": "^2.2.0",
    "@types/node": "^24.19.2",
    "@types/pg": "^8.23.1",
    "prisma": "^7.10.0",
    "tsx": "^4.23.13",
    "typescript": "^7.0.2"
  }
}
