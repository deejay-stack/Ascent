{
  "name": "ascent",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": "22.x"
  },
  "workspaces": [
    "frontend",
    "backend"
  ],
  "scripts": {
    "dev": "node scripts/dev.mts",
    "dev:client": "npm run dev --workspace @ascent/frontend",
    "server": "node backend/src/index.ts",
    "build": "npm run build --workspaces",
    "lint": "eslint .",
    "start": "npm start --workspace @ascent/backend",
    "preview": "npm run preview --workspace @ascent/frontend",
    "verify": "node frontend/tests/verify-browser.mts",
    "seed:catalog": "npm run seed:catalog --workspace @ascent/frontend",
    "test:unit": "npm run test:unit --workspaces --if-present",
    "test:integration": "npm run test:integration --workspace @ascent/backend",
    "test:system": "node frontend/tests/verify-supabase.mts",
    "test:checkout": "node frontend/tests/verify-checkout.mts",
    "test:navigation": "node frontend/tests/verify-navigation.mts",
    "test:startup": "node frontend/tests/verify-startup.mts",
    "test:auth": "node frontend/tests/verify-auth.mts",
    "test:auth-storage": "node frontend/tests/verify-auth-storage.mts",
    "db:validate": "npm run db:validate --workspace @ascent/backend --",
    "db:generate": "npm run db:generate --workspace @ascent/backend --",
    "db:migrate": "npm run db:migrate --workspace @ascent/backend --",
    "db:seed": "npm run db:seed --workspace @ascent/backend --",
    "db:check": "npm run db:check --workspace @ascent/backend --",
    "typecheck": "npm run typecheck --workspaces --if-present && npm run typecheck:tools --workspace @ascent/backend"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.9.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.4",
    "globals": "^17.11.0",
    "prettier": "^3.9.6",
    "typescript-eslint": "^8.67.0"
  }
}
