generator client {
  provider = "prisma-client-js"
}
datasource db {
  provider = "postgresql"
}
model Profile {
  id String @id @db.Uuid
  name String
  email String @unique
  role String @default("customer")
  isActive Boolean @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  @@map("profiles")
}
model Category {
  id String @id @default(uuid())
  name String @unique
  products Product[]
  @@map("categories")
}
model Product {
  id String @id @default(uuid())
  name String
  slug String @unique
  description String
  categoryId String @map("category_id")
  category Category @relation(fields:[categoryId],references:[id],onDelete:Restrict)
  sku String @unique
  barcode String @unique
  imageUrl String @map("image_url")
  costPrice Decimal @db.Decimal(12,2) @map("cost_price")
  sellingPrice Decimal @db.Decimal(12,2) @map("selling_price")
  stockQuantity Int @default(0) @map("stock_quantity")
  lowStockThreshold Int @default(7) @map("low_stock_threshold")
  unit String
  brand String?
  isAvailable Boolean @default(true) @map("is_available")
  isFeatured Boolean @default(false) @map("is_featured")
  isArchived Boolean @default(false) @map("is_archived")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  saleItems SaleItem[]
  orderItems OrderItem[]
  movements InventoryMovement[]
  @@index([categoryId,isArchived])
  @@map("products")
}
model Sale {
  id String @id
  receiptNumber String @unique @map("receipt_number")
  storeName String @map("store_name")
  storeAddress String @map("store_address")
  createdAt DateTime @default(now()) @map("created_at")
  cashier String
  cashierId String @db.Uuid @map("cashier_id")
  source String
  subtotal Decimal @db.Decimal(12,2)
  discount Decimal @db.Decimal(12,2)
  tax Decimal @db.Decimal(12,2)
  total Decimal @db.Decimal(12,2)
  paymentMethod String @map("payment_method")
  amountReceived Decimal @db.Decimal(12,2) @map("amount_received")
  change Decimal @db.Decimal(12,2)
  paymentId String @unique @map("payment_id")
  payment Payment @relation(fields:[paymentId],references:[id])
  orderId String? @unique @map("order_id")
  order Order? @relation(fields:[orderId],references:[id])
  items SaleItem[]
  @@index([createdAt])
  @@map("sales")
}
model SaleItem {
  id String @id @default(uuid())
  saleId String @map("sale_id")
  sale Sale @relation(fields:[saleId],references:[id],onDelete:Restrict)
  productId String @map("product_id")
  product Product @relation(fields:[productId],references:[id],onDelete:Restrict)
  name String
  categoryId String @map("category_id")
  unit String
  imageUrl String @map("image_url")
  quantity Int
  unitPrice Decimal @db.Decimal(12,2) @map("unit_price")
  total Decimal @db.Decimal(12,2)
  @@index([saleId])
  @@map("sale_items")
}
model Payment {
  id String @id @default(uuid())
  transactionId String @map("transaction_id")
  actorId String @db.Uuid @map("actor_id")
  method String
  total Decimal @db.Decimal(12,2)
  status String
  isDemo Boolean @default(true) @map("is_demo")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  sale Sale?
  @@map("payments")
}
model InventoryMovement {
  id String @id @default(uuid())
  productId String @map("product_id")
  product Product @relation(fields:[productId],references:[id],onDelete:Restrict)
  productName String @map("product_name")
  type String
  quantity Int
  before Int
  after Int
  reason String
  responsibleUser String @map("responsible_user")
  actorId String @db.Uuid @map("actor_id")
  reference String?
  createdAt DateTime @default(now()) @map("created_at")
  @@index([productId,createdAt])
  @@map("inventory_movements")
}
model Order {
  id String @id
  userId String @db.Uuid @map("user_id")
  status String @default("Awaiting payment")
  fulfillment String
  createdAt DateTime @default(now()) @map("created_at")
  subtotal Decimal @db.Decimal(12,2)
  total Decimal @db.Decimal(12,2)
  items OrderItem[]
  sale Sale?
  @@index([userId,createdAt])
  @@map("orders")
}
model OrderItem {
  id String @id @default(uuid())
  orderId String @map("order_id")
  order Order @relation(fields:[orderId],references:[id],onDelete:Restrict)
  productId String @map("product_id")
  product Product @relation(fields:[productId],references:[id],onDelete:Restrict)
  name String
  price Decimal @db.Decimal(12,2)
  unit String
  quantity Int
  lineTotal Decimal @db.Decimal(12,2) @map("line_total")
  @@index([orderId])
  @@map("order_items")
}
model StoreSettings {
  id String @id @default("store")
  name String @default("ASCENT")
  address String @default("Store address, Philippines")
  taxRate Decimal @default(0) @db.Decimal(5,2) @map("tax_rate")
  @@map("store_settings")
}
model NewsletterSubscription {
  email String @id
  createdAt DateTime @default(now()) @map("created_at")
  @@map("newsletter_subscriptions")
}
model StoreEvent {
  id String @id @default(uuid())
  scope String
  audienceId String? @db.Uuid @map("audience_id")
  createdAt DateTime @default(now()) @map("created_at")
  @@index([createdAt])
  @@map("store_events")
}

